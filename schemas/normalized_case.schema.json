{
  "$defs": {
    "AnalysisReference": {
      "properties": {
        "status": {
          "enum": [
            "not_yet_bound",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "title": "AnalysisReference",
      "type": "object"
    },
    "AppliedAssertion": {
      "properties": {
        "assertion_id": {
          "title": "Assertion Id",
          "type": "string"
        },
        "subject_type": {
          "title": "Subject Type",
          "type": "string"
        },
        "subject_id": {
          "title": "Subject Id",
          "type": "string"
        },
        "predicate": {
          "title": "Predicate",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "evidence_type": {
          "title": "Evidence Type",
          "type": "string"
        },
        "evidence_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "restricted": true,
          "title": "Evidence Reference"
        },
        "asserted_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "restricted": true,
          "title": "Asserted By"
        },
        "asserted_at": {
          "title": "Asserted At",
          "type": "string"
        },
        "applied": {
          "title": "Applied",
          "type": "boolean"
        },
        "rejection_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rejection Reason"
        }
      },
      "required": [
        "assertion_id",
        "subject_type",
        "subject_id",
        "predicate",
        "value",
        "evidence_type",
        "asserted_at",
        "applied"
      ],
      "title": "AppliedAssertion",
      "type": "object"
    },
    "Capability": {
      "properties": {
        "capability": {
          "title": "Capability",
          "type": "string"
        },
        "ready": {
          "enum": [
            "yes",
            "partial",
            "no"
          ],
          "title": "Ready",
          "type": "string"
        },
        "blocking_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Blocking Reasons",
          "type": "array"
        },
        "conditions": {
          "items": {
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        }
      },
      "required": [
        "capability",
        "ready"
      ],
      "title": "Capability",
      "type": "object"
    },
    "CarriedIssue": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "origin_stage": {
          "enum": [
            "case_intake",
            "case_normalization"
          ],
          "title": "Origin Stage",
          "type": "string"
        },
        "resolution": {
          "enum": [
            "unresolved",
            "addressed_by_assertion",
            "informational"
          ],
          "title": "Resolution",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "asset_ids": {
          "items": {
            "type": "string"
          },
          "title": "Asset Ids",
          "type": "array"
        },
        "sample_ids": {
          "items": {
            "type": "string"
          },
          "title": "Sample Ids",
          "type": "array"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "suggested_action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Action"
        },
        "assertion_ids": {
          "items": {
            "type": "string"
          },
          "title": "Assertion Ids",
          "type": "array"
        }
      },
      "required": [
        "code",
        "severity",
        "origin_stage",
        "resolution",
        "message"
      ],
      "title": "CarriedIssue",
      "type": "object"
    },
    "ContigBinding": {
      "properties": {
        "source_name": {
          "title": "Source Name",
          "type": "string"
        },
        "source_length": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Length"
        },
        "contig_class": {
          "$ref": "#/$defs/ContigClass"
        },
        "canonical_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Id"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "aliases": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "object"
        },
        "basis": {
          "enum": [
            "assembly_report_name_and_length",
            "assembly_report_alias_normalized",
            "assembly_report_name_only",
            "name_heuristic",
            "unbound"
          ],
          "title": "Basis",
          "type": "string"
        },
        "matched_alias": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The assembly-report alias this source name bound to (differs when chr-prefix normalization was needed).",
          "title": "Matched Alias"
        },
        "length_conflict": {
          "default": false,
          "title": "Length Conflict",
          "type": "boolean"
        },
        "records": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Per-contig record count (e.g. chrY counts reveal biology) \u2014 private only.",
          "restricted": true,
          "title": "Records"
        }
      },
      "required": [
        "source_name",
        "source_length",
        "contig_class",
        "basis"
      ],
      "title": "ContigBinding",
      "type": "object"
    },
    "ContigClass": {
      "enum": [
        "primary_chromosome",
        "mitochondrial",
        "alternate_locus",
        "unlocalized",
        "unplaced",
        "patch",
        "decoy_or_other",
        "unknown"
      ],
      "title": "ContigClass",
      "type": "string"
    },
    "ContigSummary": {
      "properties": {
        "source_scheme": {
          "title": "Source Scheme",
          "type": "string"
        },
        "declared": {
          "title": "Declared",
          "type": "integer"
        },
        "with_records": {
          "title": "With Records",
          "type": "integer"
        },
        "by_class": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "By Class",
          "type": "object"
        },
        "records_by_class": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Records By Class",
          "type": "object"
        },
        "by_basis": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "By Basis",
          "type": "object"
        },
        "length_conflicts": {
          "title": "Length Conflicts",
          "type": "integer"
        }
      },
      "required": [
        "source_scheme",
        "declared",
        "with_records",
        "by_class",
        "records_by_class",
        "by_basis",
        "length_conflicts"
      ],
      "title": "ContigSummary",
      "type": "object"
    },
    "DeclaredReference": {
      "description": "A ##reference declaration. The basename usually names the exact distribution\n(analysis set, decoys, masking, contig naming); the full value may be a local path.",
      "properties": {
        "basename": {
          "title": "Basename",
          "type": "string"
        },
        "raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "restricted": true,
          "title": "Raw"
        }
      },
      "required": [
        "basename"
      ],
      "title": "DeclaredReference",
      "type": "object"
    },
    "Execution": {
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "title": "Finished At",
          "type": "string"
        },
        "duration_seconds": {
          "title": "Duration Seconds",
          "type": "number"
        },
        "vcf_stream_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Wall-clock of the VCF pass. Execution metadata: excluded from the semantic digest.",
          "title": "Vcf Stream Seconds"
        },
        "source_manifest_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where the upstream artifact was read from \u2014 a location, not content.",
          "restricted": true,
          "title": "Source Manifest Path"
        },
        "case_root_override": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "restricted": true,
          "title": "Case Root Override"
        },
        "argv": {
          "items": {
            "type": "string"
          },
          "restricted": true,
          "title": "Argv",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "started_at",
        "finished_at",
        "duration_seconds"
      ],
      "title": "Execution",
      "type": "object"
    },
    "FilterCharacterization": {
      "properties": {
        "definitions": {
          "items": {
            "$ref": "#/$defs/FilterDefinition"
          },
          "title": "Definitions",
          "type": "array"
        },
        "pass_records": {
          "title": "Pass Records",
          "type": "integer"
        },
        "missing_filter_records": {
          "description": "FILTER '.' \u2014 filters not applied/recorded",
          "title": "Missing Filter Records",
          "type": "integer"
        },
        "non_pass_records": {
          "title": "Non Pass Records",
          "type": "integer"
        },
        "records_by_filter": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Records By Filter",
          "type": "object"
        },
        "records_with_multiple_filters": {
          "title": "Records With Multiple Filters",
          "type": "integer"
        },
        "undeclared_filters_used": {
          "items": {
            "type": "string"
          },
          "title": "Undeclared Filters Used",
          "type": "array"
        },
        "note": {
          "default": "Non-PASS records are preserved and remain part of the case; FILTER is evidence, not an exclusion rule.",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "definitions",
        "pass_records",
        "missing_filter_records",
        "non_pass_records",
        "records_by_filter",
        "records_with_multiple_filters",
        "undeclared_filters_used"
      ],
      "title": "FilterCharacterization",
      "type": "object"
    },
    "FilterDefinition": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Description"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "title": "FilterDefinition",
      "type": "object"
    },
    "FormatFieldStat": {
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "present_in_header": {
          "title": "Present In Header",
          "type": "boolean"
        },
        "header_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header Number"
        },
        "header_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header Type"
        },
        "records_declaring": {
          "title": "Records Declaring",
          "type": "integer"
        },
        "records_populated": {
          "title": "Records Populated",
          "type": "integer"
        },
        "populated_fraction": {
          "title": "Populated Fraction",
          "type": "number"
        }
      },
      "required": [
        "field",
        "present_in_header",
        "records_declaring",
        "records_populated",
        "populated_fraction"
      ],
      "title": "FormatFieldStat",
      "type": "object"
    },
    "GenomeSection": {
      "properties": {
        "reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReferenceBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "variant_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/VcfCharacterization"
            },
            {
              "type": "null"
            }
          ]
        },
        "samples": {
          "items": {
            "$ref": "#/$defs/SampleIdentity"
          },
          "title": "Samples",
          "type": "array"
        }
      },
      "required": [
        "reference",
        "variant_source",
        "samples"
      ],
      "title": "GenomeSection",
      "type": "object"
    },
    "GenotypeStates": {
      "properties": {
        "hom_ref": {
          "default": 0,
          "title": "Hom Ref",
          "type": "integer"
        },
        "het": {
          "default": 0,
          "title": "Het",
          "type": "integer"
        },
        "hom_alt": {
          "default": 0,
          "title": "Hom Alt",
          "type": "integer"
        },
        "het_non_ref": {
          "default": 0,
          "title": "Het Non Ref",
          "type": "integer"
        },
        "haploid_called": {
          "default": 0,
          "title": "Haploid Called",
          "type": "integer"
        },
        "missing": {
          "default": 0,
          "title": "Missing",
          "type": "integer"
        },
        "partially_missing": {
          "default": 0,
          "title": "Partially Missing",
          "type": "integer"
        },
        "ploidy_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Ploidy Counts",
          "type": "object"
        }
      },
      "title": "GenotypeStates",
      "type": "object"
    },
    "HpoTermNormalized": {
      "properties": {
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "restricted": true,
          "title": "Source Id"
        },
        "canonical_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "restricted": true,
          "title": "Canonical Id"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "restricted": true,
          "title": "Label"
        },
        "consider_ids": {
          "items": {
            "type": "string"
          },
          "restricted": true,
          "title": "Consider Ids",
          "type": "array"
        },
        "status": {
          "enum": [
            "active",
            "secondary_id",
            "obsolete_replaced",
            "obsolete_no_replacement",
            "unknown",
            "not_validated"
          ],
          "title": "Status",
          "type": "string"
        },
        "replacement_basis": {
          "anyOf": [
            {
              "enum": [
                "ontology_replaced_by",
                "ontology_alt_id"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replacement Basis"
        },
        "branches": {
          "items": {
            "type": "string"
          },
          "title": "Branches",
          "type": "array"
        },
        "polarity": {
          "enum": [
            "unspecified",
            "observed",
            "excluded"
          ],
          "title": "Polarity",
          "type": "string"
        },
        "polarity_basis": {
          "title": "Polarity Basis",
          "type": "string"
        },
        "source_asset_id": {
          "title": "Source Asset Id",
          "type": "string"
        }
      },
      "required": [
        "status",
        "polarity",
        "polarity_basis",
        "source_asset_id"
      ],
      "title": "HpoTermNormalized",
      "type": "object"
    },
    "LanePair": {
      "properties": {
        "lane": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lane"
        },
        "r1_asset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "R1 Asset Id"
        },
        "r2_asset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "R2 Asset Id"
        }
      },
      "required": [
        "lane",
        "r1_asset_id",
        "r2_asset_id"
      ],
      "title": "LanePair",
      "type": "object"
    },
    "Operation": {
      "properties": {
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Parameters",
          "type": "object"
        },
        "resources": {
          "items": {
            "type": "string"
          },
          "title": "Resources",
          "type": "array"
        },
        "output": {
          "title": "Output",
          "type": "string"
        },
        "transforms_source_data": {
          "default": false,
          "title": "Transforms Source Data",
          "type": "boolean"
        }
      },
      "required": [
        "operation",
        "inputs",
        "output"
      ],
      "title": "Operation",
      "type": "object"
    },
    "PedigreeSection": {
      "properties": {
        "status": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "note": {
          "title": "Note",
          "type": "string"
        },
        "relationships": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Relationships",
          "type": "array"
        }
      },
      "required": [
        "status",
        "note"
      ],
      "title": "PedigreeSection",
      "type": "object"
    },
    "PhaseInformation": {
      "properties": {
        "status": {
          "enum": [
            "none",
            "present"
          ],
          "title": "Status",
          "type": "string"
        },
        "kinds": {
          "description": "gt_phased_separator | phase_set_PS | read_backed_PGT_PID",
          "items": {
            "type": "string"
          },
          "title": "Kinds",
          "type": "array"
        },
        "het_records": {
          "title": "Het Records",
          "type": "integer"
        },
        "het_records_gt_phased": {
          "title": "Het Records Gt Phased",
          "type": "integer"
        },
        "ps_populated_records": {
          "title": "Ps Populated Records",
          "type": "integer"
        },
        "pgt_populated_records": {
          "title": "Pgt Populated Records",
          "type": "integer"
        },
        "pid_populated_records": {
          "title": "Pid Populated Records",
          "type": "integer"
        },
        "note": {
          "default": "Structural availability only; no phasing was inferred.",
          "title": "Note",
          "type": "string"
        },
        "interpretation_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mechanical explanation of the observed combination of phase fields.",
          "title": "Interpretation Note"
        }
      },
      "required": [
        "status",
        "het_records",
        "het_records_gt_phased",
        "ps_populated_records",
        "pgt_populated_records",
        "pid_populated_records"
      ],
      "title": "PhaseInformation",
      "type": "object"
    },
    "PhenotypeSection": {
      "properties": {
        "status": {
          "enum": [
            "normalized",
            "not_validated_resource_unavailable",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "ontology": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "ontology_release": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ontology Release"
        },
        "source_term_count": {
          "title": "Source Term Count",
          "type": "integer"
        },
        "canonical_term_count": {
          "title": "Canonical Term Count",
          "type": "integer"
        },
        "status_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Status Counts",
          "type": "object"
        },
        "polarity_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Polarity Counts",
          "type": "object"
        },
        "branch_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Branch Counts",
          "type": "object"
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/HpoTermNormalized"
          },
          "title": "Terms",
